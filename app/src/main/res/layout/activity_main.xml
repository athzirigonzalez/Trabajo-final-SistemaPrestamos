<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F5F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="#0F172A"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvMainRolBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2563EB"
                android:paddingLeft="10dp"
                android:paddingTop="4dp"
                android:paddingRight="10dp"
                android:paddingBottom="4dp"
                android:text="PERFIL: CLIENTE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMainBienvenida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Bienvenido"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMainDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Selecciona una opción disponible"
                android:textColor="#94A3B8"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- OPCIONES EXCLUSIVAS DEL CLIENTE -->
        <Button
            android:id="@+id/btnNuevoPrestamo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#5B4B9E"
            android:text="Solicitar Préstamo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDetalleMiPrestamo"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#2563EB"
            android:text="Ver Detalle de mi Préstamo"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- OPCIONES EXCLUSIVAS DEL MANAGER / ADMINISTRADOR -->
        <Button
            android:id="@+id/btnVerDashboard"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:backgroundTint="#1E293B"
            android:text="Cartera de Clientes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVerManager"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#0F172A"
            android:text="Panel de Gerencia (Solicitudes)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRegistrarAbonoMenu"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#10B981"
            android:text="Realizar Abono y Recibos"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- BOTÓN COMÚN PARA CERRAR SESIÓN -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#E2E8F0"
            android:text="Cerrar Sesión"
            android:textAllCaps="false"
            android:textColor="#334155"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>